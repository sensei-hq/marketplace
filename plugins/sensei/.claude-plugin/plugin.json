{
  "name": "sensei",
  "version": "0.21.1",
  "description": "AI development intelligence — mindset-driven agents, code graph, session telemetry",
  "author": {
    "name": "sensei-hq"
  },
  "homepage": "https://www.sensei-hq.com",
  "repository": "https://github.com/sensei-hq/sensei",
  "license": "MIT",
  "keywords": [
    "code-intelligence",
    "development",
    "quality",
    "mindsets",
    "agents"
  ],
  "mcpServers": {
    "sensei": {
      "command": "${CLAUDE_PLUGIN_ROOT}/bin/sensei-mcp.sh"
    }
  },
  "userConfig": {
    "relayGate": {
      "type": "boolean",
      "title": "Relay tool gate",
      "description": "Ask the sensei daemon before each tool call; a dōjō member can decline it from their phone. It only ever tightens a decision, and an unreachable daemon allows.",
      "default": false
    },
    "runDrive": {
      "type": "boolean",
      "title": "Run drive",
      "description": "Submit a dōjō member's nudges for a run this session started as prompts, each once, once the session is idle. Off: nudges stay pull-only (get_pending_nudges).",
      "default": false
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd session-start"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd pre-compact"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd forward"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd forward"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd nudge"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd forward"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd forward"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd forward"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd forward"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd forward"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd forward"
          }
        ]
      }
    ]
  }
}
